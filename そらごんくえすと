<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ルミナスの勇者 - Open Scenario RPG</title>
    <style>
        body {
            background-color: #121212;
            color: #e0e0e0;
            font-family: 'Helvetica Neue', Arial, 'Hiragino Kaku Gothic ProN', 'Meiryo', sans-serif;
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }
        #game-container {
            width: 100%;
            max-width: 800px;
            background-color: #1e1e1e;
            border: 2px solid #444;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
        }
        h1 {
            text-align: center;
            color: #f39c12;
            margin-top: 0;
            border-bottom: 2px solid #444;
            padding-bottom: 10px;
        }
        #status-bar {
            display: flex;
            justify-content: space-between;
            background-color: #2a2a2a;
            padding: 10px 15px;
            border-radius: 5px;
            margin-bottom: 15px;
            font-weight: bold;
            flex-wrap: wrap;
            gap: 10px;
        }
        #status-bar div {
            font-size: 0.95rem;
        }
        #display-area {
            background-color: #000;
            border: 1px solid #333;
            border-radius: 5px;
            height: 250px;
            padding: 15px;
            overflow-y: auto;
            margin-bottom: 15px;
            line-height: 1.6;
            white-space: pre-wrap;
        }
        #controls {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }
        button {
            background-color: #34495e;
            color: #fff;
            border: none;
            padding: 12px;
            border-radius: 5px;
            font-size: 1rem;
            cursor: pointer;
            transition: background 0.2s;
        }
        button:hover {
            background-color: #2c3e50;
        }
        button:disabled {
            background-color: #555;
            cursor: not-allowed;
            opacity: 0.6;
        }
        .orbs {
            color: #e74c3c;
        }
    </style>
</head>
<body>

<div id="game-container">
    <h1>ルミナスの勇者</h1>
    
    <div id="status-bar">
        <div>HP: <span id="hp">100</span>/<span id="max-hp">100</span></div>
        <div>所持金: <span id="gold">50</span> G</div>
        <div>武器: <span id="weapon">古びた剣</span></div>
        <div>場所: <span id="location">ルミナス村</span></div>
        <div>宝珠: <span id="orbs" class="orbs">0/4</span></div>
    </div>

    <div id="display-area"></div>

    <div id="controls"></div>
</div>

<script>
// --- ゲームデータと状態 ---
const gameState = {
    hp: 100,
    maxHp: 100,
    atk: 15,
    gold: 50,
    weapon: "古びた剣",
    location: "luminous",
    orbs: {
        fire: false,
        wind: false,
        water: false,
        shadow: false
    },
    flags: {
        metGrandpa: false,
        hasShip: false,
        guildQuestDone: false
    }
};

const display = document.getElementById('display-area');
const controls = document.getElementById('controls');

function log(text) {
    display.innerText += text + "\n\n";
    display.scrollTop = display.scrollHeight;
}

function clearLog() {
    display.innerText = "";
}

function updateStatus() {
    document.getElementById('hp').innerText = gameState.hp;
    document.getElementById('max-hp').innerText = gameState.maxHp;
    document.getElementById('gold').innerText = gameState.gold;
    document.getElementById('weapon').innerText = gameState.weapon;
    
    const orbCount = Object.values(gameState.orbs).filter(Boolean).length;
    document.getElementById('orbs').innerText = `${orbCount}/4`;

    const locNames = {
        luminous: "ルミナス村",
        bazaar: "商業都市グランバザール",
        volcano: "鉱山街ボルカノ",
        silphy: "樹上の村シルフィ",
        aquaris: "港町アクアリス",
        granval: "聖地グラン・ヴァル",
        demonCastle: "魔王城"
    };
    document.getElementById('location').innerText = locNames[gameState.location] || "未知の土地";
}

function setButtons(buttonConfig) {
    controls.innerHTML = "";
    buttonConfig.forEach(cfg => {
        const btn = document.createElement('button');
        btn.innerText = cfg.text;
        btn.onclick = cfg.action;
        if (cfg.disabled) btn.disabled = true;
        controls.appendChild(btn);
    });
}

// --- 戦闘システム ---
function startBattle(enemyName, enemyHp, enemyAtk, onWin) {
    clearLog();
    log(`【戦闘発生！】${enemyName}が現れた！`);
    
    let currentEnemyHp = enemyHp;

    function renderBattleUI() {
        setButtons([
            {
                text: "攻撃する",
                action: () => {
                    clearLog();
                    const damage = Math.max(5, gameState.atk + Math.floor(Math.random() * 5));
                    currentEnemyHp -= damage;
                    log(`あなたの攻撃！ ${enemyName}に ${damage} のダメージ！`);

                    if (currentEnemyHp <= 0) {
                        log(`【勝利！】${enemyName}を倒した！`);
                        onWin();
                        return;
                    }

                    // 敵の反撃
                    const enemyDamage = Math.max(2, enemyAtk + Math.floor(Math.random() * 5));
                    gameState.hp -= enemyDamage;
                    log(`${enemyName}の攻撃！ あなたは ${enemyDamage} のダメージを受けた！`);
                    updateStatus();

                    if (gameState.hp <= 0) {
                        gameState.hp = 0;
                        updateStatus();
                        log(`\n【敗北】あなたは倒れてしまった…`);
                        setButtons([{
                            text: "ルミナス村で復活",
                            action: () => {
                                gameState.hp = gameState.maxHp;
                                goToLocation('luminous');
                            }
                        }]);
                    } else {
                        renderBattleUI();
                    }
                }
            },
            {
                text: "回復薬を使う (20G)",
                action: () => {
                    clearLog();
                    if (gameState.gold >= 20) {
                        gameState.gold -= 20;
                        const heal = 40;
                        gameState.hp = Math.min(gameState.maxHp, gameState.hp + heal);
                        log(`回復薬を使用し、HPが ${heal} 回復した！`);
                        updateStatus();
                    } else {
                        log(`お金が足りない！`);
                    }
                    renderBattleUI();
                }
            }
        ]);
    }

    renderBattleUI();
}

// --- エリア・ナビゲーション ---
function goToLocation(loc) {
    gameState.location = loc;
    updateStatus();
    clearLog();

    switch(loc) {
        case 'luminous':
            log("【ルミナス村】\n精霊の大樹に見守られた静かな故郷。");
            setButtons([
                { text: "長老の家に行く", action: talkToGrandpa },
                { text: "宿屋で休む (無料)", action: () => { gameState.hp = gameState.maxHp; updateStatus(); log("HPが全回復した！"); } },
                { text: "ワールドマップへ", action: showWorldMap }
            ]);
            break;

        case 'bazaar':
            log("【商業都市グランバザール】\n世界最大の交易都市。多くの冒険者で賑わっている。");
            setButtons([
                { text: "武器屋に行く", action: shopBazaar },
                { text: "冒険者ギルド（賞金首討伐）", action: guildQuest },
                { text: "ワールドマップへ", action: showWorldMap }
            ]);
            break;

        case 'volcano':
            log("【鉱山街ボルカノ】\n火山の麓に広がるドワーフの街。炎将ガルダの脅威に晒されている。");
            setButtons([
                { text: "鍛冶場（武器強化）", action: shopVolcano },
                { text: "炎将ガルダに挑む（火の宝珠）", action: bossGaruda, disabled: gameState.orbs.fire },
                { text: "ワールドマップへ", action: showWorldMap }
            ]);
            break;

        case 'silphy':
            log("【樹上の村シルフィ】\n巨木の上に佇むエルフの里。幻影妃セレーネの呪いで混沌としている。");
            setButtons([
                { text: "幻影妃セレーネに挑む（風の宝珠）", action: bossSelene, disabled: gameState.orbs.wind },
                { text: "ワールドマップへ", action: showWorldMap }
            ]);
            break;

        case 'aquaris':
            log("【港町アクアリス】\n海風が心地よい港町。沖合には嵐竜ヴァルザーが潜む。");
            let buttons = [
                { text: "嵐竜ヴァルザーに挑む（水の宝珠）", action: bossValzar, disabled: gameState.orbs.water || !gameState.flags.hasShip },
                { text: "ワールドマップへ", action: showWorldMap }
            ];
            if (!gameState.flags.hasShip) {
                buttons.unshift({ text: "船を入手する (150G)", action: buyShip });
            }
            setButtons(buttons);
            break;

        case 'granval':
            log("【聖地グラン・ヴァル】\n雪深い山頂の聖域。冥将ゼノスが静寂を侵食している。");
            setButtons([
                { text: "冥将ゼノスに挑む（影の宝珠）", action: bossZenos, disabled: gameState.orbs.shadow },
                { text: "ワールドマップへ", action: showWorldMap }
            ]);
            break;

        case 'demonCastle':
            const orbCount = Object.values(gameState.orbs).filter(Boolean).length;
            if (orbCount < 4) {
                log("【魔王城の門】\n強力な結界が張られており進めない！\n世界各地にある「4つの宝珠」を集める必要がある。");
                setButtons([{ text: "ワールドマップへ戻る", action: showWorldMap }]);
            } else {
                log("【魔王城】\n4つの宝珠が共鳴し、結界が消滅した！\n奥で魔王が待っている…！");
                setButtons([
                    { text: "魔王に挑む", action: bossDemonKing },
                    { text: "ワールドマップへ戻る", action: showWorldMap }
                ]);
            }
            break;
    }
}

function showWorldMap() {
    clearLog();
    log("【ワールドマップ】\n行きたい目的地を選択してください。");
    setButtons([
        { text: "中央：ルミナス村", action: () => goToLocation('luminous') },
        { text: "中央：グランバザール", action: () => goToLocation('bazaar') },
        { text: "西部：ボルカノ", action: () => goToLocation('volcano') },
        { text: "東部：シルフィ", action: () => goToLocation('silphy') },
        { text: "南部：アクアリス", action: () => goToLocation('aquaris') },
        { text: "北部：グラン・ヴァル", action: () => goToLocation('granval') },
        { text: "決戦：魔王城", action: () => goToLocation('demonCastle') }
    ]);
}

// --- イベント＆ショップ ---
function talkToGrandpa() {
    clearLog();
    if (!gameState.flags.metGrandpa) {
        log("長老「勇者よ、魔王を倒すには4つの『四精霊の宝珠』が必要じゃ。世界各地を巡り、力を示してくるのだ。」");
        gameState.flags.metGrandpa = true;
    } else {
        log("長老「旅の調子はどうじゃ？ 無理はせんようにな。」");
    }
    goToLocation('luminous');
}

function shopBazaar() {
    clearLog();
    log("武器屋「いらっしゃい！ 良い装備そろってるよ。」");
    setButtons([
        {
            text: "鋼鉄の剣を購入 (100G / 攻撃力+15)",
            action: () => {
                if (gameState.gold >= 100) {
                    gameState.gold -= 100;
                    gameState.atk = 30;
                    gameState.weapon = "鋼鉄の剣";
                    log("「鋼鉄の剣」を購入し、装備した！");
                    updateStatus();
                } else {
                    log("ゴールドが足りない！");
                }
            }
        },
        { text: "戻る", action: () => goToLocation('bazaar') }
    ]);
}

function guildQuest() {
    clearLog();
    if (gameState.flags.guildQuestDone) {
        log("ギルド職員「現在依頼はありません。また来てください！」");
        goToLocation('bazaar');
        return;
    }
    log("ギルド職員「街の近くに出没する『盗賊頭』を倒してください！」");
    startBattle("盗賊頭", 60, 8, () => {
        log("ギルド報酬として 100G を獲得した！");
        gameState.gold += 100;
        gameState.flags.guildQuestDone = true;
        updateStatus();
        setButtons([{ text: "街に戻る", action: () => goToLocation('bazaar') }]);
    });
}

function shopVolcano() {
    clearLog();
    log("伝説の鍛冶師「ワシの腕にかかれば、オリハルコンの剣だって作れるぞ！」");
    setButtons([
        {
            text: "オリハルコンの剣を購入 (300G / 攻撃力+35)",
            action: () => {
                if (gameState.gold >= 300) {
                    gameState.gold -= 300;
                    gameState.atk = 50;
                    gameState.weapon = "オリハルコンの剣";
                    log("「オリハルコンの剣」を手に入れた！");
                    updateStatus();
                } else {
                    log("ゴールドが足りない！");
                }
            }
        },
        { text: "戻る", action: () => goToLocation('volcano') }
    ]);
}

function buyShip() {
    clearLog();
    if (gameState.gold >= 150) {
        gameState.gold -= 150;
        gameState.flags.hasShip = true;
        updateStatus();
        log("頑丈な航海船を手に入れた！これで沖合の離島へ渡れる！");
    } else {
        log("船を買うためのゴールドが足りない！");
    }
    goToLocation('aquaris');
}

// --- ボス戦 ---
function bossGaruda() {
    startBattle("炎将ガルダ", 120, 15, () => {
        log("【火の宝珠】を手に入れた！ 報酬として150G獲得！");
        gameState.orbs.fire = true;
        gameState.gold += 150;
        updateStatus();
        setButtons([{ text: "ボルカノへ戻る", action: () => goToLocation('volcano') }]);
    });
}

function bossSelene() {
    startBattle("幻影妃セレーネ", 140, 18, () => {
        log("【風の宝珠】を手に入れた！ 報酬として150G獲得！");
        gameState.orbs.wind = true;
        gameState.gold += 150;
        updateStatus();
        setButtons([{ text: "シルフィへ戻る", action: () => goToLocation('silphy') }]);
    });
}

function bossValzar() {
    startBattle("嵐竜ヴァルザー", 180, 22, () => {
        log("【水の宝珠】を手に入れた！ 報酬として200G獲得！");
        gameState.orbs.water = true;
        gameState.gold += 200;
        updateStatus();
        setButtons([{ text: "アクアリスへ戻る", action: () => goToLocation('aquaris') }]);
    });
}

function bossZenos() {
    startBattle("冥将ゼノス", 220, 25, () => {
        log("【影の宝珠】を手に入れた！ 報酬として250G獲得！");
        gameState.orbs.shadow = true;
        gameState.gold += 250;
        updateStatus();
        setButtons([{ text: "グラン・ヴァルへ戻る", action: () => goToLocation('granval') }]);
    });
}

function bossDemonKing() {
    startBattle("魔王", 350, 32, () => {
        clearLog();
        log("【エンディング】\n激闘の末、あなたは魔王を撃破した！\n世界に平和が戻り、あなたの名は伝説の勇者として語り継がれるだろう…！\n\n～ FIN ～");
        setButtons([{
            text: "タイトルへ戻る",
            action: () => location.reload()
        }]);
    });
}

// 初期起動
goToLocation('luminous');
</script>

</body>
</html>
